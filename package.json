{
  "name": "@razedotbot/charts",
  "version": "0.3.1",
  "description": "Open, dependency-free Canvas-2D financial charting library — TradingView widget drop-in plus SVG dashboard charts.",
  "license": "MIT",
  "author": "Raze",
  "type": "module",
  "sideEffects": false,
  "main": "dist/charting_library.cjs.js",
  "module": "dist/charting_library.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/charting_library.esm.js",
      "require": "./dist/charting_library.cjs.js",
      "default": "./dist/charting_library.esm.js"
    },
    "./chart": {
      "types": "./dist/types/chart/index.d.ts",
      "import": "./dist/chart.esm.js",
      "require": "./dist/chart.cjs.js",
      "default": "./dist/chart.esm.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.esm.js",
      "require": "./dist/react.cjs.js",
      "default": "./dist/react.esm.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "chart": ["./dist/types/chart/index.d.ts"],
      "react": ["./dist/types/react/index.d.ts"]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs && node examples/smoke.mjs && node tests/chart.mjs",
    "test:visual": "node build.mjs && npx playwright test",
    "test:visual:update": "node build.mjs && npx playwright test --update-snapshots",
    "dev": "node build.mjs --watch",
    "sync": "node scripts/sync-to-app.mjs",
    "prepare": "node scripts/prepare.mjs",
    "prepack": "node build.mjs",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/razedotbot/raze-charts.git"
  },
  "homepage": "https://github.com/razedotbot/raze-charts#readme",
  "bugs": {
    "url": "https://github.com/razedotbot/raze-charts/issues"
  },
  "keywords": [
    "charts",
    "charting",
    "canvas",
    "candlestick",
    "financial",
    "trading",
    "ohlcv",
    "technical-indicators",
    "tradingview",
    "datafeed",
    "charting-library",
    "svg",
    "dashboard",
    "react"
  ],
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/react": "^18.3.12",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "typescript": "^5.6.0"
  }
}
