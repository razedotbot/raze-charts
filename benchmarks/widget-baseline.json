{
  "version": 1,
  "suite": "financial-widget-browser",
  "description": "Financial widget in headless Chromium: load, repaint, crosshair, pan, wheel, six-study repaint, live ticks and retained heap.",
  "environment": {
    "viewport": "1100x620 CSS px at DPR 1 (the visual-golden surface)",
    "data": "Deterministic 1-minute OHLCV random walk; the whole series is served on the first request",
    "chrome": "Default widget chrome, dark theme, countdown and popup hints disabled",
    "timing": "Main-thread milliseconds: synchronous input handler plus every requestAnimationFrame callback it causes, plus a forced 1x1 canvas readback so rasterisation is included; load is wall time from construction to the first painted data frame",
    "heap": "Runtime.getHeapUsage usedSize after two forced GCs, minus the page before the series was generated"
  },
  "budgetPolicy": {
    "time": "max(10 ms, 6x reference median)",
    "heap": "max(16 MB, 2x reference median)"
  },
